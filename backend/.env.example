# Copy this file to .env and fill in what you need.
# Everything below has a working default in app/core/config.py except the
# credentials, which are required for the features they enable — the app
# still runs without them, just with that feature turned off.

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Database (local PostgreSQL) ---
DATABASE_URL=postgresql://vaakify:vaakify@localhost:5432/vaakify

# --- Speech-to-text ---
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Chatbot fallback (optional; the Q&A-bank matcher works without this) ---
ANTHROPIC_API_KEY=

# --- Legacy Supabase (only needed if you haven't finished the Postgres migration) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Email OTP (Gmail SMTP) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=false

# --- Google sign-in ---
# Web application OAuth client ID from https://console.cloud.google.com/apis/credentials
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env — the backend uses this
# to verify the ID token the frontend gets back from Google.
GOOGLE_CLIENT_ID=

# --- Phone sign-in (Twilio Verify) ---
# From https://console.twilio.com — create a Verify service and use its SID
# (starts with VA...), not a regular Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
